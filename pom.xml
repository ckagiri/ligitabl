<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ligitabl</groupId>
    <artifactId>ligitabl-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LigiTabl Parent</name>
    <description>Aggregator for the LigiTabl monorepo</description>

    <properties>
        <!-- Centralized versions -->
        <lombok.version>1.18.32</lombok.version>

        <!-- Default DB connection properties for tooling (jOOQ, Liquibase, tests).
             These mirror the values in .env and can be overridden with -DDB_* on the command line. -->
        <DB_HOST>localhost</DB_HOST>
        <DB_PORT>55432</DB_PORT>
        <DB_NAME>ligitabl</DB_NAME>
        <DB_USER>ligitabl</DB_USER>
        <DB_PASSWORD>ligitabl</DB_PASSWORD>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin Lombok version for all modules -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>jooq-codegen</module>
        <module>model</module>
        <module>api</module>
        <module>seed</module>
    </modules>

        <build>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.44.0</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat>
                                <version>2.38.0</version>
                            </palantirJavaFormat>
                            <importOrder>
                                <order>java,javax,org,com</order>
                            </importOrder>
                            <encoding>UTF-8</encoding>
                            <removeUnusedImports/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </build>
</project>
