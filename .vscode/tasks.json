    {
      "label": "TestAuth: start postgres container",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "docker rm -f ligitabl-testapi-db >/dev/null 2>&1 || true\n\ndocker run -d --name ligitabl-testapi-db -e POSTGRES_DB=ligitabl -e POSTGRES_USER=ligitabl -e POSTGRES_PASSWORD=ligitabl -p 15432:5432 postgres:16 >/dev/null\n\nfor i in $(seq 1 30); do\n  if docker exec ligitabl-testapi-db pg_isready -U ligitabl -d ligitabl >/dev/null 2>&1; then\n    echo \"Postgres is ready.\";\n    exit 0;\n  fi\n  sleep 1\ndone\n\necho \"Postgres did not become ready in time\" >&2\nexit 1"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
