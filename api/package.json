{
  "name": "ligitabl",
  "version": "1.0.0",
  "description": "Ligitabl UI",
  "main": "index.js",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build": "npm run copy:vendor && vite build --mode production",
    "copy:vendor": "mkdir -p src/main/resources/static/vendor && cp node_modules/htmx.org/dist/htmx.min.js src/main/resources/static/vendor/htmx.min.js && cp node_modules/alpinejs/dist/cdn.min.js src/main/resources/static/vendor/alpine.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckagiri/ligitablui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ckagiri/ligitablui/issues"
  },
  "homepage": "https://github.com/ckagiri/ligitablui#readme",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "alpinejs": "3.16.3",
    "autoprefixer": "^10.4.23",
    "htmx.org": "1.9.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.44.1",
    "vite": "^7.3.1"
  }
}
