<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Registers Spring Boot's custom converters including %clr -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty name="LOGTAIL_TOKEN" source="logtail.token" defaultValue=""/>

  <!-- Console: all environments, coloured output via Spring Boot's %clr() -->
  <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss}){faint} %clr(%5p) %clr([requestId=%X{requestId}]){faint} %clr(%logger{36}){cyan} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Logtail: prod profile only. WARN+ globally; INFO+ for scheduling package. -->
  <!-- Uses Jsr310LogtailAppender, not the vanilla LogtailAppender: the vanilla appender's
       internal ObjectMapper lacks the JSR-310 module, so any log argument of type
       Instant/OffsetDateTime throws while serializing the batch to JSON, silently dropping
       every event bundled in that batch (not just the offending one). -->
  <springProfile name="prod">
    <appender name="Logtail" class="com.ligitabl.api.logging.Jsr310LogtailAppender">
      <appName>ligitabl</appName>
      <sourceToken>${LOGTAIL_TOKEN}</sourceToken>
      <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
        <level>WARN</level>
      </filter>
    </appender>

    <!-- Separate appender for scheduling: INFO+ without the WARN threshold -->
    <appender name="LogtailScheduling" class="com.ligitabl.api.logging.Jsr310LogtailAppender">
      <appName>ligitabl</appName>
      <sourceToken>${LOGTAIL_TOKEN}</sourceToken>
      <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
        <level>INFO</level>
      </filter>
    </appender>

    <!-- additivity=false: scheduling logs go here only, not through root's WARN-filtered Logtail -->
    <logger name="com.ligitabl.api.scheduling" level="INFO" additivity="false">
      <appender-ref ref="Console"/>
      <appender-ref ref="LogtailScheduling"/>
    </logger>

    <!-- JoinReminderEnqueuer does its logging from notification.outbox, not scheduling, even
         though it's only ever invoked by scheduled/startup jobs -->
    <logger name="com.ligitabl.api.notification.outbox" level="INFO" additivity="false">
      <appender-ref ref="Console"/>
      <appender-ref ref="LogtailScheduling"/>
    </logger>

    <root level="INFO">
      <appender-ref ref="Console"/>
      <appender-ref ref="Logtail"/>
    </root>
  </springProfile>

  <springProfile name="!prod">
    <root level="INFO">
      <appender-ref ref="Console"/>
    </root>
  </springProfile>

</configuration>
