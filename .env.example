# App settings
PORT=8080
JAVA_OPTS=

# Database (used by docker-compose postgres container)
DB_NAME=ligitabl
DB_USER=ligitabl
DB_PASSWORD=ligitabl
DB_PORT=5432

# Spring datasource (override defaults if needed)
# For Compose (inside app container, default host is 'db')
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ligitabl
SPRING_DATASOURCE_USERNAME=ligitabl
SPRING_DATASOURCE_PASSWORD=ligitabl
SPRING_LIQUIBASE_ENABLED=false

# jOOQ code generation (used by `make codegen`)
JOOQ_DB_URL=jdbc:postgresql://localhost:5432/ligitabl
JOOQ_DB_USER=ligitabl
JOOQ_DB_PASSWORD=ligitabl
