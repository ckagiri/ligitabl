# Dev environment defaults
#
# Usage:
#   make env-info ENV=dev
#   make dev-reset ENV=dev
#   make run-api ENV=dev

# App settings
PORT=8080
JAVA_OPTS=

# Database (used by docker-compose postgres container)
DB_HOST=localhost
DB_NAME=ligitabl_dev
DB_USER=ligitabl
DB_PASSWORD=ligitabl
# When using Docker Compose in this repo, the host port is 55432 by default
DB_PORT=55432

# Put secrets in .env.dev.local (gitignored)
# API_FOOTBALL_DATA_KEY=
