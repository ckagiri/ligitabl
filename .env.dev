# Dev environment defaults
#
# Usage:
#   make env-info ENV=dev
#   make dev-reset ENV=dev
#   make run-api ENV=dev

# App settings
PORT=8080
JAVA_OPTS=

# Effectively disable the global rate limiter for local manual testing
RATE_LIMIT_REQUESTS_PER_MINUTE=100000

# Safety: round-results emails only go to accounts in the
# round_results_email_ignore_list app setting, never real users — even if
ROUND_RESULTS_EMAIL_MODE=test

# Database (used by docker-compose postgres container)
DB_HOST=localhost
DB_NAME=ligitabl_dev
DB_USER=ligitabl
DB_PASSWORD=ligitabl
# When using Docker Compose in this repo, the host port is 55432 by default
DB_PORT=55432
DB_CONTAINER=ligitabl-db

# Put secrets in .env.dev.local (gitignored)
# API_FOOTBALL_DATA_KEY=
