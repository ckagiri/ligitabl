# App settings
PORT=8080
JAVA_OPTS=

# Effectively disable the global rate limiter for local manual testing
RATE_LIMIT_REQUESTS_PER_MINUTE=100000

# Database (used by docker-compose postgres container)
DB_HOST=localhost
DB_NAME=ligitabl_dev
DB_USER=ligitabl
DB_PASSWORD=ligitabl
# When using Docker Compose in this repo, the host port is 55432 by default
DB_PORT=55432

# Spring profiles
# Liquibase is disabled by default; enable it at runtime with:
#   SPRING_PROFILES_ACTIVE=liquibase

# jOOQ code generation uses DB_* above (no separate JOOQ_* needed)

# Put secrets (API keys, etc.) in .env.dev.local (gitignored)
# API_FOOTBALL_DATA_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=ligipredictor.com
# EMAIL_FROM=notifications@ligipredictor.com
# EMAIL_FROM_NAME=LigiPredictor
