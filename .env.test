# Test environment defaults for running scripts/TestSeeding.sh + scripts/TestAuth.sh
#
# Usage:
# - ./scripts/TestSeeding.sh
# - ./scripts/TestAuth.sh            (API must be running)
# - ./scripts/TestAuthAndSeeding.sh  (runs both)

# --- Local docker-compose DB (for destructive smoke tests) ---
# Use a separate DB name + host port so the scripts don't clobber a dev DB.
DB_HOST=localhost
DB_NAME=ligitabl_test
DB_USER=ligitabl
DB_PASSWORD=ligitabl
HOST_DB_PORT=55433
DB_PORT=55433
DB_CONTAINER=ligitabl-db

# --- Auth smoke test ---
# If you run `make test-seeding-auth`, the API will be started automatically.
PORT=8081
BASE_URL=http://localhost:8081
LOGIN_PATH=/auth/login
ME_PATH=/api/me
ADMIN_ONLY_PATH=/api/admin
PLAYER_ONLY_PATH=/api/player

# These match the seed users in seed/src/main/resources/seeding/users.yaml
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
PLAYER_EMAIL=player1@example.com
PLAYER_PASSWORD=player12345
SUPER_EMAIL=superuser@example.com
SUPER_PASSWORD=super12345

# --- Email (Gmail SMTP) ---
EMAIL_PROVIDER=gmail-smtp
EMAIL_FROM=ligipredictor@gmail.com
EMAIL_FROM_NAME=LigiPredictor
GMAIL_USERNAME=ligipredictor@gmail.com
